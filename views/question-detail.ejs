<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
    <%- include('partials/menu') %>

    <div class="container py-4">
        <!-- Question -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <!-- Vote buttons -->
                            <div class="col-md-1 text-center">
                                <% if (user) { %>
                                    <div class="voting-buttons">
                                        <button class="btn btn-outline-success btn-sm mb-2 vote-btn" 
                                                data-type="up" 
                                                data-question-id="<%= question.id %>"
                                                data-target="question">
                                            <i class="fas fa-chevron-up"></i>
                                        </button>
                                        <div class="text-center mb-2">
                                            <span class="badge bg-primary fs-6 vote-count"><%= question.votes %></span>
                                        </div>
                                        <button class="btn btn-outline-danger btn-sm vote-btn" 
                                                data-type="down" 
                                                data-question-id="<%= question.id %>"
                                                data-target="question">
                                            <i class="fas fa-chevron-down"></i>
                                        </button>
                                    </div>
                                <% } else { %>
                                    <div class="text-center">
                                        <span class="badge bg-primary fs-6"><%= question.votes %></span>
                                        <br>
                                        <small class="text-muted">votes</small>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Question content -->
                            <div class="col-md-11">
                                <h1 class="h3 mb-3"><%= question.title %></h1>
                                <div class="mb-3">
                                    <pre class="question-content"><%= question.content %></pre>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <img src="<%= question.gravatar %>" alt="<%= question.author %>" class="rounded-circle me-2" width="32" height="32">
                                        <div>
                                            <strong><%= question.author %></strong>
                                            <br>
                                            <small class="text-muted">
                                                <i class="fas fa-clock me-1"></i>
                                                <%= new Date(question.created_at).toLocaleDateString() %>
                                            </small>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-comments me-1"></i>
                                            <%= answers.length %> answers
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Answers -->
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="mb-3">
                    <i class="fas fa-comments me-2"></i>
                    Answers (<%= answers.length %>)
                </h4>

                <% if (answers.length === 0) { %>
                    <div class="text-center py-4">
                        <i class="fas fa-comment-slash fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No answers yet. Be the first to help!</p>
                    </div>
                <% } else { %>
                    <% answers.forEach(answer => { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="row">
                                    <!-- Vote buttons -->
                                    <div class="col-md-1 text-center">
                                        <% if (user) { %>
                                            <div class="voting-buttons">
                                                <button class="btn btn-outline-success btn-sm mb-2 vote-btn" 
                                                        data-type="up" 
                                                        data-question-id="<%= question.id %>"
                                                        data-answer-id="<%= answer.id %>"
                                                        data-target="answer">
                                                    <i class="fas fa-chevron-up"></i>
                                                </button>
                                                <div class="text-center mb-2">
                                                    <span class="badge bg-success fs-6 vote-count"><%= answer.votes %></span>
                                                </div>
                                                <button class="btn btn-outline-danger btn-sm vote-btn" 
                                                        data-type="down" 
                                                        data-question-id="<%= question.id %>"
                                                        data-answer-id="<%= answer.id %>"
                                                        data-target="answer">
                                                    <i class="fas fa-chevron-down"></i>
                                                </button>
                                            </div>
                                        <% } else { %>
                                            <div class="text-center">
                                                <span class="badge bg-success fs-6"><%= answer.votes %></span>
                                                <br>
                                                <small class="text-muted">votes</small>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Answer content -->
                                    <div class="col-md-11">
                                        <div class="mb-3">
                                            <pre class="answer-content"><%= answer.content %></pre>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <img src="<%= answer.gravatar %>" alt="<%= answer.author %>" class="rounded-circle me-2" width="32" height="32">
                                            <div>
                                                <strong><%= answer.author %></strong>
                                                <br>
                                                <small class="text-muted">
                                                    <i class="fas fa-clock me-1"></i>
                                                    <%= new Date(answer.created_at).toLocaleDateString() %>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <!-- Answer Form -->
        <% if (user) { %>
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
                                <i class="fas fa-edit me-2"></i>Your Answer
                            </h5>
                        </div>
                        <div class="card-body">
                            <form action="/questions/<%= question.id %>/answer" method="POST">
                                <div class="mb-3">
                                    <textarea 
                                        class="form-control" 
                                        name="content" 
                                        rows="8" 
                                        placeholder="Write your answer here. Be detailed and helpful..."
                                        required
                                    ></textarea>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <a href="/questions" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left me-2"></i>Back to Questions
                                    </a>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-paper-plane me-2"></i>Post Answer
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="row">
                <div class="col-12">
                    <div class="card bg-light">
                        <div class="card-body text-center">
                            <h5>Want to answer this question?</h5>
                            <p class="text-muted">You need to be logged in to post an answer.</p>
                            <a href="/auth" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Login to Answer
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <%- include('partials/footer') %>

    <!-- JavaScript for voting -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const voteButtons = document.querySelectorAll('.vote-btn');
            
            voteButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const type = this.dataset.type;
                    const questionId = this.dataset.questionId;
                    const answerId = this.dataset.answerId;
                    const target = this.dataset.target;
                    
                    let url;
                    if (target === 'question') {
                        url = `/questions/${questionId}/vote`;
                    } else {
                        url = `/questions/${questionId}/answers/${answerId}/vote`;
                    }
                    
                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ type: type })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Update vote count (in a real app, you'd get the new count from the API)
                            const voteCountElement = this.parentElement.querySelector('.vote-count');
                            let currentVotes = parseInt(voteCountElement.textContent);
                            if (type === 'up') {
                                currentVotes++;
                            } else {
                                currentVotes--;
                            }
                            voteCountElement.textContent = currentVotes;
                            
                            // Show success message
                            const alert = document.createElement('div');
                            alert.className = 'alert alert-success alert-dismissible fade show';
                            alert.innerHTML = `
                                <i class="fas fa-check me-2"></i>
                                Vote recorded successfully!
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            `;
                            document.querySelector('.container').insertBefore(alert, document.querySelector('.container').firstChild);
                            
                            // Auto-dismiss after 3 seconds
                            setTimeout(() => {
                                alert.remove();
                            }, 3000);
                        } else {
                            alert('Error: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('An error occurred while voting');
                    });
                });
            });
        });
    </script>

    <style>
        .question-content, .answer-content {
            background: none;
            border: none;
            padding: 0;
            margin: 0;
            white-space: pre-wrap;
            word-wrap: break-word;
            font-family: inherit;
        }
        
        .voting-buttons .btn {
            width: 40px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .vote-count {
            font-size: 14px !important;
        }
    </style>
</body>

</html>
