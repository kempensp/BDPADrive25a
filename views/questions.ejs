<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>

<body>
    <%- include('partials/menu') %>

    <div class="container py-4">
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 class="h3 mb-2">
                    <i class="fas fa-question-circle me-2"></i>Questions
                </h1>
                <p class="text-muted">Browse and answer questions from the community</p>
            </div>
            <div class="col-md-4 text-md-end">
                <% if (user) { %>
                    <a href="/questions/new" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Ask Question
                    </a>
                <% } else { %>
                    <a href="/auth" class="btn btn-outline-primary">
                        <i class="fas fa-sign-in-alt me-2"></i>Login to Ask
                    </a>
                <% } %>
            </div>
        </div>

        <!-- Questions List -->
        <div class="row">
            <div class="col-12">
                <% if (questions.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="fas fa-question-circle fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">No questions yet</h4>
                        <p class="text-muted">Be the first to ask a question!</p>
                        <% if (user) { %>
                            <a href="/questions/new" class="btn btn-primary">Ask the First Question</a>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="row">
                        <% questions.forEach(question => { %>
                            <div class="col-12 mb-4">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-2 text-center">
                                                <div class="mb-2">
                                                    <span class="badge bg-primary fs-6"><%= question.votes %></span>
                                                    <br>
                                                    <small class="text-muted">votes</small>
                                                </div>
                                                <div class="mb-2">
                                                    <span class="badge bg-success fs-6"><%= question.answers_count %></span>
                                                    <br>
                                                    <small class="text-muted">answers</small>
                                                </div>
                                            </div>
                                            <div class="col-md-10">
                                                <h5 class="card-title">
                                                    <a href="/questions/<%= question.id %>" class="text-decoration-none">
                                                        <%= question.title %>
                                                    </a>
                                                </h5>
                                                <p class="card-text text-muted">
                                                    <%= question.content.substring(0, 200) %>
                                                    <% if (question.content.length > 200) { %>...<%}%>
                                                </p>
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <div class="text-muted small">
                                                        <i class="fas fa-user me-1"></i>
                                                        <%= question.author %>
                                                    </div>
                                                    <div class="text-muted small">
                                                        <i class="fas fa-clock me-1"></i>
                                                        <%= new Date(question.created_at).toLocaleDateString() %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
</body>

</html>
